# Non-secret worker settings. The database URL is mounted as a Docker secret.
# EMBEDDING_MODEL must match public.opinion_classifier_settings.embedding_model.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

BATCH_SIZE=8
POLL_INTERVAL_SECONDS=2
DISCOVERY_REFRESH_INTERVAL_SECONDS=300
TREND_REFRESH_INTERVAL_SECONDS=300
VISIBILITY_TIMEOUT_SECONDS=300
MAX_ATTEMPTS=5
LOG_LEVEL=INFO
