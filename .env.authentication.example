# Production frontend. In local development, omit this variable: the React
# development server proxies /api/auth to Supabase so the session is same-origin.
REACT_APP_AUTH_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1

# Edge Function secrets for online deployment. Local React development on
# localhost:3000 or 127.0.0.1:3000 is already allowed by the backend.
# Set these with `supabase secrets set`; do not expose them as REACT_APP_*.
AUTH_ALLOWED_ORIGINS=https://YOUR_SITE_DOMAIN
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None

# Edge Function secret. Generate a different random value for development and
# production. Never expose it in a REACT_APP_* variable or commit its value.
AUTH_PASSWORD_PEPPER=GENERATE_A_RANDOM_64_CHARACTER_HEX_VALUE
